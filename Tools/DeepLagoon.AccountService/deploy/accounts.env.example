# root-owned, mode 0600; no database credentials in the Discord Bot environment.
ACCOUNT_LISTEN_PORT=1213
ACCOUNT_DB_ENGINE=postgres
# Use a dedicated login with the grants in grants.sql, not the game owner.
ACCOUNT_DB_CONNECTION="Host=127.0.0.1;Port=5432;Database=REPLACE_DATABASE;Username=lagoon_accounts;Password=REPLACE_PASSWORD;Timeout=5;Command Timeout=8"
# Resolve from the active server data root and discord_link.database_file.
# This example matches the isolated deployment; verify the actual path first.
ACCOUNT_LINK_DATABASE=/home/ss14/ss14/runtime-data/discord/discord-links.db
ACCOUNT_RECEIPT_DATABASE=/var/lib/deeplagoon-accounts/receipts.db
# Independent random keys, at least 32 characters. Must differ from each other
# and from identity/moderation/supporter/root keys. Never derive WL from identity.
ACCOUNT_WHITELIST_TOKEN=REPLACE_WITH_RANDOM_WHITELIST_KEY
ACCOUNT_COIN_TOKEN=REPLACE_WITH_RANDOM_COIN_KEY
