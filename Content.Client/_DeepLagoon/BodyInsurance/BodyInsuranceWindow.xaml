<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    SetSize="340 260"
    MinSize="340 260">

    <BoxContainer
        Orientation="Vertical"
        Margin="12 8 12 12">

        <PanelContainer
            HorizontalExpand="True"
            StyleClasses="PanelDark">

            <BoxContainer
                Orientation="Vertical"
                Margin="10 10 10 10">

                <Label
                    Name="PriceLabel"
                    HorizontalAlignment="Center"
                    StyleClasses="LabelKeyText"/>

                <Label
                    Name="SubscriptionPriceLabel"
                    HorizontalAlignment="Center"
                    Margin="0 8 0 0"/>

                <Label
                    Name="SubscriptionStatusLabel"
                    HorizontalAlignment="Center"
                    Margin="0 4 0 0"/>

                <Label
                    Name="PurchaseCountLabel"
                    HorizontalAlignment="Center"
                    Margin="0 8 0 0"/>

                <Label
                    Name="InsuranceStatusLabel"
                    HorizontalAlignment="Center"
                    Margin="0 4 0 0"/>

            </BoxContainer>

        </PanelContainer>

        <Button
            Name="PurchaseButton"
            Text="{Loc 'body-insurance-purchase'}"
            HorizontalExpand="True"
            MinSize="0 38"
            Margin="0 10 0 0"
            Disabled="True"/>

    </BoxContainer>

</controls:FancyWindow>
