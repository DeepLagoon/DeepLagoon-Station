<tabs:DeltaTab xmlns="https://spacestation14.io"
               xmlns:tabs="clr-namespace:Content.Client._DV.Options.UI.Tabs"
               xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <Label Text="{Loc 'dl-options-interface'}" StyleClasses="LabelKeyText" />
                <ui:OptionDropDown Name="DropDownInterfaceStyle" Title="{Loc 'dl-ui-style-title'}" />
                <RichTextLabel Text="{Loc 'dl-ui-style-hint'}" />
                <CheckBox Name="VanillaChat" Text="{Loc 'ui-options-vanilla-chat'}" />
                <CheckBox Name="LobbyAnimatedBackgroundCheckBox" Text="{Loc 'deeplagoon-options-lobby-animation'}"
                          ToolTip="{Loc 'deeplagoon-options-lobby-animation-tooltip'}" />

                <Label Text="{Loc 'ui-options-client-prediction'}" StyleClasses="LabelKeyText" />
                <CheckBox Name="ClientPredictionCheckBox" Text="{Loc 'ui-options-client-prediction'}" />
                <RichTextLabel Text="{Loc 'dl-options-prediction-hint'}" />
                <ui:OptionSlider Name="PredictionTicksSlider" Title="{Loc 'dl-options-prediction-strength'}"
                                 ToolTip="{Loc 'dl-options-prediction-strength-tooltip'}" />
                <ui:OptionSlider Name="PredictionLagSlider" Title="{Loc 'dl-options-prediction-lag'}"
                                 ToolTip="{Loc 'dl-options-prediction-lag-tooltip'}" />
                <ui:OptionSlider Name="PredictionSmoothingSlider" Title="{Loc 'dl-options-prediction-smoothing'}"
                                 ToolTip="{Loc 'dl-options-prediction-smoothing-tooltip'}" />

                <Label Text="{Loc 'dl-options-graphics'}" StyleClasses="LabelKeyText" />
                <CheckBox Name="LightBloomCheckBox" Text="{Loc 'ui-options-light-bloom'}" />
                <ui:OptionSlider Name="LightBloomIntensitySlider" Title="{Loc 'ui-options-light-bloom-intensity'}" />
                <CheckBox Name="ContactOcclusionCheckBox" Text="{Loc 'deeplagoon-options-ambient-occlusion'}" />
                <CheckBox Name="AmbientOcclusionEntitiesCheckBox" Text="{Loc 'ui-options-ambient-occlusion-entities'}" />
                <ui:OptionSlider Name="AmbientOcclusionIntensitySlider" Title="{Loc 'ui-options-ambient-occlusion-intensity'}" />
                <ui:OptionSlider Name="AmbientOcclusionDrawDistanceSlider" Title="{Loc 'ui-options-ambient-occlusion-draw-distance'}" />
                <ui:OptionSlider Name="AmbientOcclusionMaxCastersSlider" Title="{Loc 'ui-options-ambient-occlusion-max-casters'}" />

                <Label Text="{Loc 'dl-options-character'}" StyleClasses="LabelKeyText" />
                <CheckBox Name="TattoosEnabled" Text="{Loc 'ui-options-tattoos-enabled'}"
                          ToolTip="{Loc 'ui-options-tattoos-enabled-tooltip'}" />
                <CheckBox Name="BodyChemicalChangesCheckBox" Text="{Loc 'ui-options-body-chemical-changes'}" />
                <Label Text="{Loc 'ui-options-general-accessibility'}" StyleClasses="LabelKeyText" />
                <CheckBox Name="DisableFiltersCheckBox" Text="{Loc 'ui-options-no-filters'}" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:DeltaTab>
