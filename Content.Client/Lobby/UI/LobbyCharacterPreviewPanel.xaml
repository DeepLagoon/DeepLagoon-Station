<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lobby="clr-namespace:Content.Client.Lobby.UI">
    <lobby:LobbyConsolePanel Name="Frame">
        <BoxContainer Name="VBox" Orientation="Vertical" SeparationOverride="8">
            <Label Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}" HorizontalAlignment="Center" />
            <BoxContainer Name="Loaded" Orientation="Vertical"
                          Visible="False" SeparationOverride="4">
                <Label Name="Summary" Align="Center" ClipText="True"/>
                <BoxContainer HorizontalAlignment="Center" SeparationOverride="5">
                    <Label Text="$" />
                    <lobby:LobbySegmentCounter Name="BankBalance" />
                </BoxContainer>
                <!-- Company Display -->
                <RichTextLabel Name="Company" HorizontalAlignment="Center"/>
                <!-- End Frontier -->
                <Control Name="ViewBox" HorizontalAlignment="Center" SetSize="224 224" MinSize="224 224">
                    <lobby:LobbyCharacterLight />
                </Control>
                <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                        HorizontalAlignment="Center"
                        Margin="0 5 0 0"/>
                <Label Name="SubscriptionLevel" Text="Без подписки" HorizontalAlignment="Center" />
                <BoxContainer HorizontalAlignment="Center" SeparationOverride="6">
                    <Label Text="Lagoon Coin:" />
                    <lobby:LobbySegmentCounter Name="LagoonCoins" />
                    <Label Text="LC" />
                </BoxContainer>
            </BoxContainer>
            <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" ClipText="True"/>
        </BoxContainer>
    </lobby:LobbyConsolePanel>
</Control>
