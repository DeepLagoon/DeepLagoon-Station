<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Client\</OutputPath>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <WarningsAsErrors>RA0032;nullable</WarningsAsErrors>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <PackageReference Include="Nett" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Pidgin" />
    <PackageReference Include="Robust.Shared.AuthLib" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Lidgren.props" />
  <Import Project="..\RobustToolbox\Imports\Client.props" />
  <!-- A full release must compile against the exact signed module selected by the official launcher. -->
  <Import Project="..\RobustToolbox\Imports\WebView.props" Condition="'$(WebViewSignedReference)' == ''" />
  <ItemGroup Condition="'$(WebViewSignedReference)' != ''">
    <Reference Include="Robust.Client.WebView">
      <HintPath>$(WebViewSignedReference)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Import Project="..\RobustToolbox\Imports\Shared.props" />

  <Target Name="RequireSignedWebViewReference" BeforeTargets="ResolveReferences"
          Condition="'$(FullRelease)' == 'True'">
    <Error Condition="'$(WebViewSignedReference)' == '' or !Exists('$(WebViewSignedReference)')"
           Text="FullRelease requires WebViewSignedReference to the verified official Robust.Client.WebView.dll." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Content.Shared\Content.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="_Mono\Research\UI\" />
  </ItemGroup>
  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\XamlIL.targets" />
  <!-- Executable ProjectReferences copy DLLs, but CEF also needs its subprocess apphost. -->
  <Target Name="CopyWebViewSubprocess" AfterTargets="Build" Condition="'$(FullRelease)' != 'True' and '$(WebViewSignedReference)' == ''">
    <MSBuild Projects="..\RobustToolbox\Robust.Client.WebView\Robust.Client.WebView.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WebViewTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_WebViewSubprocess Include="@(_WebViewTargetPath->'%(RootDir)%(Directory)Robust.Client.WebView.exe');@(_WebViewTargetPath->'%(RootDir)%(Directory)Robust.Client.WebView');@(_WebViewTargetPath->'%(RootDir)%(Directory)Robust.Client.WebView.runtimeconfig.json');@(_WebViewTargetPath->'%(RootDir)%(Directory)Robust.Client.WebView.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebViewSubprocess)" DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" Condition="Exists('%(_WebViewSubprocess.Identity)')" />
  </Target>
</Project>
