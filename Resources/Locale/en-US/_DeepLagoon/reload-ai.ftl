cmd-reloadai-desc = Reboots the AI module: clears stuck planning jobs and makes mobs, drones and autopilot plan again.
cmd-reloadai-help = Usage: {$command}
    Takes no arguments. Use it when mobs, drones or autopilot stop working.
cmd-reloadai-wrong-args = This command takes no arguments. Usage: {$command}
cmd-reloadai-done = AI module rebooted: restarted {$count}, restored {$restored}.
