dl-music-command-desc = Open the server-wide music control panel
dl-music-command-help = music - opens the music control window
dl-music-invalid-token = The access token is invalid or expired

dl-music-cmd-play-desc = Play a track server-wide by its id
dl-music-cmd-play-help = musicplay <trackId> [title]
dl-music-cmd-play-usage = Provide a track id: musicplay <trackId>. Find one with musicdiag <query>.
dl-music-cmd-play-bad-id = Invalid track id: '{$id}'.
dl-music-cmd-play-ok = Track {$id} is now playing server-wide.
dl-music-cmd-play-fail = Could not play track {$id}. Check the server log for 'dl.music'.
dl-music-cmd-stop-desc = Stop music server-wide
dl-music-cmd-stop-ok = Music stopped.
dl-music-cmd-status-desc = Show what is playing now
dl-music-cmd-status-state = state: {$state}
dl-music-cmd-status-listeners = listeners: {$count}
dl-music-cmd-status-gain = gain: {$gain}
dl-music-cmd-status-nothing = nothing is playing
dl-music-cmd-status-playing = playing: {$title} - {$artist} (id {$id}, {$duration}s)
dl-music-cmd-diag-desc = Check the music configuration without revealing the token
dl-music-cmd-diag-help = musicdiag [search query]
dl-music-diag-no-token = token: EMPTY. Set it with 'cvar dl_music.token <value>' in the server console or via 'sudo' from the client.
dl-music-diag-token = token: present, length {$length}, starts with '{$prefix}...'
dl-music-diag-oauth-prefix = WARNING: the value starts with 'OAuth'. Only the token itself is needed.
dl-music-diag-trimmed = WARNING: the value had surrounding spaces, which are trimmed.
dl-music-diag-disabled = dl_music.enabled is off - enable it: cvar dl_music.enabled true
dl-music-diag-probing = searching for '{$query}'...
dl-music-diag-failed = RESULT: error {$status}.
dl-music-diag-hint-token = The token never reached the server. Make sure you set it on the SERVER.
dl-music-diag-hint-disabled = Music is disabled by dl_music.enabled.
dl-music-diag-hint-rate = Too many requests, wait a moment.
dl-music-diag-hint-query = Empty or invalid query.
dl-music-diag-hint-invalid = The API rejected the token: wrong or expired. Make sure it was copied whole, with no tail after &.
dl-music-diag-hint-error = The API returned an error. See the server log for 'dl.music'.
dl-music-diag-found = RESULT: success, found {$count} tracks.
dl-music-diag-empty = The token was accepted but the result is empty - check the query.