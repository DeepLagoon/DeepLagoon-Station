light_mode unshaded;

uniform highp vec2 viewport_size;

highp float phosphorNoise(highp vec2 pixel, highp float frame) {
    return fract(sin(dot(pixel, vec2(12.9898, 78.233)) + frame * 17.31) * 43758.5453);
}

void fragment() {
    // Local, coloured white noise at 12 Hz. It is drawn before any radar marks:
    // no noise texture uploads, screen readback, blur or framebuffer copies.
    highp vec2 pixel = floor(UV * viewport_size / 1.25);
    highp float grain = (phosphorNoise(pixel, floor(TIME * 12.0)) - 0.5) * 0.06;
    highp vec3 tint = vec3(0.38, 0.65, 0.8);
    highp vec3 backing = vec3(0.043137, 0.070588, 0.086275);
    highp vec3 surface = clamp(backing + grain * tint, vec3(0.0), vec3(1.0));
    COLOR = zFromSrgb(vec4(surface, 1.0));
}
