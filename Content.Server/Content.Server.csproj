<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Server\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <NoWarn>1998</NoWarn>
    <WarningsAsErrors>RA0032;nullable</WarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <PropertyGroup Condition="Exists('$(DeepLagoonEngineRoot)/Robust.Shared/EntitySerialization/EntitySerializer.Incremental.cs')">
    <DefineConstants>$(DefineConstants);DEEPLAGOON_ENGINE_INCREMENTAL_SNAPSHOTS</DefineConstants>
  </PropertyGroup>
  <!-- The memory snapshot bridge is optional: the pinned engine predates this API.
       Enable it automatically when the reviewed engine source provides both types. -->
  <PropertyGroup Condition="Exists('$(DeepLagoonEngineRoot)/Robust.Server/Diagnostics/ServerMemoryDiagnostics.cs') and Exists('$(DeepLagoonEngineRoot)/Robust.Server/Diagnostics/MemoryDiagnosticCounters.cs')">
    <DefineConstants>$(DefineConstants);DEEPLAGOON_ENGINE_MEMORY_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <Target Name="DeepLagoonReportMemoryDiagnosticsCapability" BeforeTargets="CoreCompile"
          Condition="!Exists('$(DeepLagoonEngineRoot)/Robust.Server/Diagnostics/ServerMemoryDiagnostics.cs') or !Exists('$(DeepLagoonEngineRoot)/Robust.Server/Diagnostics/MemoryDiagnosticCounters.cs')">
    <Message Importance="High" Text="Optional engine memory snapshot bridge unavailable in the pinned engine; content counters and the performance monitor remain available." />
  </Target>
  <!-- CI's stock-client build uses the official engine without the server-only notification APIs.
       Production builds use the pinned server fork and include these systems. -->
  <PropertyGroup Condition="'$(DeepLagoonStockValidation)' == 'true'">
    <DefineConstants>$(DefineConstants);DEEPLAGOON_STOCK_ENGINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeepLagoonStockValidation)' == 'true'">
    <Compile Remove="_DeepLagoon/Physics/InvalidPhysicsAlertSystem.cs" />
    <Compile Remove="_DeepLagoon/Administration/AdminProvenanceSystem.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="NLayer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Content.Packaging\Content.Packaging.csproj" />
    <ProjectReference Include="..\Content.Server.Database\Content.Server.Database.csproj" />
    <ProjectReference Include="..\Content.Shared.Database\Content.Shared.Database.csproj" />
    <ProjectReference Include="..\Content.Shared\Content.Shared.csproj" />
  </ItemGroup>
  <Import Project="$(DeepLagoonEngineRoot)\MSBuild\Robust.Properties.targets" />

  <Import Project="$(DeepLagoonEngineRoot)\Imports\Lidgren.props" />
  <Import Project="$(DeepLagoonEngineRoot)\Imports\Server.props" />
  <Import Project="$(DeepLagoonEngineRoot)\Imports\Shared.props" />
  <Import Project="$(DeepLagoonEngineRoot)\Imports\Packaging.props" />
</Project>
